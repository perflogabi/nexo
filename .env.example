# Copie para `.env` (ou `.env.local`) — nunca commitar segredos.
# Banco oficial: Neon PostgreSQL. Obtenha as URLs no painel Neon (Connection details).
# Não use Postgres local como requisito do projeto.

# --- Neon + Prisma 6 ---
# DATABASE_URL: conexão da APLICAÇÃO (preferir endpoint pooled do Neon).
#   No console Neon: Connection string → "Pooled connection" (−pooler no host).
#   Inclua ?sslmode=require (e schema=public se desejar).
#
# DIRECT_URL: conexão DIRETA para migrations / prisma migrate / introspect.
#   No console Neon: Connection string → "Direct connection" (sem −pooler).
#   Obrigatória neste schema (Prisma 6 `directUrl`) — use a string Direct do mesmo projeto.
#
# Substitua USER, PASSWORD, HOST e DATABASE pelos valores do seu projeto Neon.
# NÃO invente credenciais; copie do painel.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Sessão demo (auth simplificada — PRD: qualquer senha nos exemplos)
AUTH_SECRET="change-me-in-local-dev"

# Gemini — preferido no chat; se falhar/timeout, cai no mock no mesmo turno
# GEMINI_API_KEY=
# AGENT_LLM=mock|gemini  (default: mock se CI ou sem chave; gemini+fallback se houver chave)
# Free tier: preferir lite (melhor quota). Cadeia de fallback no código.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_MS=20000



# Opcional: limiar auxiliar de confiança (hipótese — nunca critério único de transferência)
# LOW_CONFIDENCE_SCORE_MAX=0.4


# TTL PendingConfirmation em minutos (hipótese — não é requisito do PRD)
# PENDING_CONFIRMATION_TTL_MINUTES=30

# E2E
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E=1

# --- Vercel (futuro) ---
# Defina as mesmas variáveis (DATABASE_URL, DIRECT_URL, AUTH_SECRET, …) em
# Project Settings → Environment Variables. Não versione valores reais.
