# Copie para `.env` (ou `.env.local`) — nunca commitar segredos.
# Banco oficial: Neon PostgreSQL. Obtenha as URLs no painel Neon (Connection details).
# Postgres local NÃO é requisito do projeto — exceto via Docker opcional (docs/docker.md)
# ou E2E (docker-compose.e2e.yml — nunca use este .env para E2E).

# --- Docker demo (avaliadores) ---
#   docker compose up --build   → app :3000 + Postgres (NEXO_ENV=demo, AGENT_LLM=mock)
#   Contas: ana.souza@nexo.com.br · analista@nexo.local (qualquer senha)

# --- Neon + Prisma 6 ---
# DATABASE_URL: pooled. DIRECT_URL: direct (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="change-me-in-local-dev"

# Runtime do produto: production | development | demo | test | e2e
# Produção (Vercel): NEXO_ENV=production + AGENT_LLM=gemini + GEMINI_API_KEY
# Demo Docker: NEXO_ENV=demo + AGENT_LLM=mock
# NEXO_ENV=development

# Gemini — só servidor (sem NEXT_PUBLIC_). Em produção não há fallback silencioso para mock.
# GEMINI_API_KEY=
# AGENT_LLM=mock|gemini
#   - production: apenas gemini (mock é rejeitado)
#   - development/demo/test/e2e: mock permitido se AGENT_LLM=mock
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT_MS=20000

# Rate limit (MVP em memória)
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=60000
# RATE_LIMIT_AGENT_MAX=30
# RATE_LIMIT_AGENT_WINDOW_MS=60000

# LOW_CONFIDENCE_SCORE_MAX=0.4
# PENDING_CONFIRMATION_TTL_MINUTES=30

# --- E2E (NÃO coloque Neon aqui; scripts injetam env) ---
# npm run db:e2e:up && npm run db:e2e:prepare && npm run test:integration && npm run test:e2e
# Defaults dos scripts: postgresql://nexo_e2e:nexo_e2e@127.0.0.1:5433/nexo_e2e
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# --- Vercel ---
# NEXO_ENV=production
# AGENT_LLM=gemini
# GEMINI_API_KEY=…
# DATABASE_URL / DIRECT_URL / AUTH_SECRET do projeto Neon
